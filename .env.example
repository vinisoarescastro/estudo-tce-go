# Copie para .env e ajuste. Variáveis do ambiente do sistema têm prioridade sobre este arquivo.
# Não há segredos obrigatórios: as sessões usam tokens aleatórios guardados com hash no banco.

# production ativa o cookie seguro (só HTTPS) por padrão
NODE_ENV=production

# Endereço em que o Node escuta. Atrás de proxy (Caddy/Nginx) na mesma máquina, use 127.0.0.1.
# No Docker, use 0.0.0.0 (o docker-compose.yml já define).
HOST=127.0.0.1
PORT=3000

# Pasta do banco SQLite e das cópias de segurança (faça backup desta pasta)
DATA_DIR=./data
# DB_FILE=estudo.db
# BACKUP_DIR=./data/backups

# Pasta do frontend gerado por "npm run build"
# WEB_DIR=./build/web

# Cookie só por HTTPS. Deixe true em produção; false apenas para testar sem HTTPS.
COOKIE_SECURE=true
# true quando houver proxy reverso na frente (usa X-Forwarded-For/Host para IP e origem)
TRUST_PROXY=true
# Origens extras autorizadas a enviar alterações, separadas por vírgula (normalmente vazio)
# ALLOWED_ORIGINS=https://estudo.seudominio.com.br

# Sessões: expiram após N dias sem uso e, no máximo, após N dias desde o login
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30

# Bloqueio de login após falhas seguidas (janela de 15 minutos)
LOGIN_MAX_FAILS_EMAIL=5
LOGIN_MAX_FAILS_IP=20
LOGIN_LOCK_MINUTES=15

# Cópias automáticas do banco (0 desliga)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# debug, info, aviso ou erro
LOG_LEVEL=info
